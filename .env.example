# Environment variables are read from the process; no secrets are shipped.
HOST=127.0.0.1
PORT=8787
# Enable when running behind an HTTPS reverse proxy.
# SOLAR_SECURE_COOKIE=1
# SOLAR_DATA_DIR=C:/solar-data
# Optional Nova Poshta API key (the public directory works without it; a key raises rate limits).
# NP_API_KEY=

# --- monobank acquiring (plata by mono) ---
# Merchant token from the monobank business cabinet (internet acquiring). Never commit it.
# MONO_TOKEN=
# Public HTTPS address of the shop. Needed for instant payment notifications (webhook)
# and for the customer's return link after payment. Example: https://solar.com.ua
# SOLAR_PUBLIC_URL=
